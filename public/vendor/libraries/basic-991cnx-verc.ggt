// Gadgets 配置文件
// 格式: $NAME {VALUE}
// 规范：如果运行后会pop额外寄存器，则在末尾增加&寄存器名，如果有其它效果则在头部加上?，如果RT返回则在末尾增加?

//寄存器赋值
$er0= {a821x1xx}
$er2= {1488x1xx}
$er4= {7c82x1xx}
$er6= {ee39x1xx}
$er8= {4a6dx1xx}
$er10= {18c2x0xx}
$er12= {3215x2xx}
$er14= {720dx2xx}
$xr0= {3461x1xx}
$xr4= {786dx1xx}
$xr8= {4638x1xx}
$xr12= {2cd5x1xx}
$qr0= {e230x1xx}
$qr8= {3632x1xx}
$qr8qr0= {7c23x2xx}
$?eaxr4= {760ex1xx}
$?ea=er12? {467bx1xx}
$er0er4= {d487x1xx}

//寄存器操作
$er0-=er12&e8e12 {7e53x2xx}
$er4=er0+r2*er4? {bc3ax1xx}
$er0=?r2*er0+er4? {124bx1xx}
$?er2=er0? {144bx1xx}
$er0=er2&r12 {4cbdx0xx}
$er14=er0&x0 {cc79x1xx}

$r0=er0<=er2? {9ab5x0xx}
$r0=er0>=er2? {b2b5x0xx}
$?r0=er2==er4? {ae93x1xx}
$?r0=er0==er2? {6a8dx0xx}


//特殊
$EI_POPPC {d891x0xx}
$DI_RT {8c92x0xx}
$rstlr {48b9x2xx} //重置lr

//sp赋值
$sp=er14&q8 {342dx1xx}
$sp=er6&e8 {381dx2xx}
$sp=er4+32&x4q8 {2692x1xx}

//工具函数
$strcpy {cc03x2xx} //[er2]->[er0]
$memcpy {f086x0xx} //[er2]->[er0]，长度由sp指向的内存决定
$memcpy_special {cc87x1xx}
$memcpy_new {06cdx0xx} //[er10]->[er12],长度由er0决定,运行完之后mpov sp, er14;popxr4qr8
$memset {928fx0xx} //从er0处填入r2的内容，长度由sp指向的内存决定
$memcat {d603x2xx} //从er0处开始向后遍历，直到遇到00，并向后追加er2处的内容
$memzero {ba8fx0xx} //将[er0]处的字节设为0，长度由栈传参
$[er0]=r2 {d203x2xx}    //[er0]赋值为r2
$[er8]+=er2&x8 {248fx0xx}   //[er8] += er2，并pop xr8
$[er0]=er2? {1639x1xx}
$?[er4]=er0&eax4 {720ex1xx}     //[er4]赋值为er0，并popea和xr4


$print {b221x2xx}
$line_print {2082x0xx} //r0:行，r1:列，跟随系统字体
$render_bitmap {d08ax0xx}
$render_ddd4 {0687x0xx}
$render_e3d4 {807ex0xx}
$screen_on? {1093x0xx}
$ddd4_to_e3d4 {807ex0xx}
$clear {807ex0xx}
$delay {6c91x0xx}

$hex_byte? {9224x2xx} //r0处字节码转换为字符串到er0

$waitkeyto[er0] {48f7x0xx}
$?readkeyto[er8]&x4q8 {54a8x2xx}

$byte->num {4ed9x1xx}     //[er0]：output_num er2：input_byte
$ranint {6039x1xx} //[er0]:input_min&output,[er2]:input_max
$calc_func {dc77x1xx} //解析算式并计算，[er0]:formula,[er2]:result
$num->byte {885fx1xx fe5fx1xx} //[er0]:input_num,[er12]:input_num,er0:output_byte
$num->str {745dx1xx} //［er0]:num, [er2]:string, [d112]:进制

$mode_calc {0e95x2xx} //进入输入模式
$magic {bc73x1xx} //在xr8为32 80 32 32的情况下，将[er14]的数字拼接后复制到[er12+0x1a]处

$traverse_by_ea {a48ex0xx}
$?er6qr8=[ea] {68c3x1xx}

//古早小工具
$waitshift {c421x2xx}
$shutdown {2491x2xx}